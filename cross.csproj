<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>warnings</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Suppress non-functional warnings left over from the WPF migration:
         nullable annotation noise (CS8632/8602/8604), deprecated FileDialog APIs
         retained for compatibility (CS0618), and unused fields/vars/events.
         These do not affect runtime behavior and are safe to revisit later. -->
    <NoWarn>$(NoWarn);CS8632;CS8602;CS8604;CS0618;CS0414;CS0168;CS0067;CS0219;NETSDK1206;CS4014;CS0105</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SQLite" Version="3.13.0" />
    <PackageReference Include="System.Data.Odbc" Version="6.0.0" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.118" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="11.3.9.4" />
    <PackageReference Include="Xaml.Behaviors.Interactions" Version="11.3.9.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\DbcView.axaml.cs">
      <DependentUpon>DbcView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ProIntroductionPage.axaml.cs">
      <DependentUpon>ProIntroductionPage.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\SerialConfigPage.axaml.cs">
      <DependentUpon>SerialConfigPage.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CANConfigPage.axaml.cs">
      <DependentUpon>CANConfigPage.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\SerialConfigWindow.axaml.cs">
      <DependentUpon>SerialConfigWindow.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\DeviceControlPage.axaml.cs">
      <DependentUpon>DeviceControlPage.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
