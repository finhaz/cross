<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:cross.ViewModels"
             xmlns:converters="using:cross.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="cross.Views.GeneralDebugPage"
             Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0 0 0 1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#B2DFDB"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <converters:BoolToButtonTextConverter x:Key="BoolToButtonTextConverter"/>
            <converters:ValueDisplayConverter x:Key="ValueDisplayConverter"/>
            <converters:TransferTypeEnableConverter x:Key="TransferTypeEnableConverter"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26*"/>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26*"/>
                <ColumnDefinition Width="40*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>

            <TextBox HorizontalAlignment="Left" Grid.Row="0"
                     Text="协议类型" FontSize="10" Grid.ColumnSpan="2"
                     TextAlignment="Center" VerticalAlignment="Center"/>

            <ComboBox Name="cPro" FontSize="10" Grid.Row="0"
                      Margin="60,1,0,1" Grid.ColumnSpan="2"
                      ItemsSource="{Binding Path=ProtocolConfig.ProtocolTypeOptions}"
                      SelectedItem="{Binding Path=ProtocolConfig.SelectedProtocolType, Mode=TwoWay}"
                      SelectionChanged="cPro_SelectionChanged"/>

            <Button x:Name="ButtonAdd" Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Grid.Row="1" Grid.ColumnSpan="2" Click="ButtonAdd_Click">
                <TextBlock Text="添加条目" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <Button x:Name="ButtonDelete" Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Grid.Row="2" Grid.ColumnSpan="2" Click="ButtonDelete_Click">
                <TextBlock Text="删除条目" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <Button x:Name="ExportConfigBtn" Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Grid.Row="3" Grid.ColumnSpan="2" Click="ExportConfig_Click">
                <TextBlock Text="导出配置" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <Button x:Name="ImportConfigBtn" Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Grid.Row="4" Grid.ColumnSpan="2" Click="ImportConfig_Click">
                <TextBlock Text="导入配置" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <Button Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Grid.Row="5" Grid.ColumnSpan="2" Click="AdvancedColumns_Click">
                <TextBlock Text="高级列" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <Grid Name="Setadd" Grid.Row="6" Grid.ColumnSpan="2" IsVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="40*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>

                <TextBox Text="参数名" Grid.Row="0" IsReadOnly="True"/>
                <TextBox Text="{Binding Path=AddItemName, Mode=TwoWay}"
                         Grid.Row="0" Grid.Column="1"/>

                <TextBox Text="数量" Grid.Row="1" IsReadOnly="True"/>
                <TextBox Text="{Binding Path=Snum, Mode=TwoWay}"
                         Grid.Row="1" Grid.Column="1"/>

                <TextBox Text="类型" Grid.Row="2" IsReadOnly="True"/>
                <Border Grid.Row="2" Grid.Column="1"
                        CornerRadius="6" Background="#E0F2F1"
                        Margin="8" ClipToBounds="True">
                    <ComboBox Name="cbProcho" FontSize="10"
                              ItemsSource="{Binding Path=ProtocolConfig.DataTypeOptions}"
                              SelectedItem="{Binding Path=ProtocolConfig.SelectedDataType, Mode=TwoWay}"
                              Background="Transparent" BorderThickness="0"
                              VerticalContentAlignment="Center" Padding="6,0"/>
                </Border>

                <TextBox Text="起始地址" Grid.Row="3" IsReadOnly="True"/>
                <TextBox Text="{Binding Path=Sadd, Mode=TwoWay}"
                         Grid.Row="3" Grid.Column="1"/>

                <Button Content="确定" Grid.Row="4" Grid.Column="0"
                        Width="80" Height="38"
                        Background="#E0F2F1" Foreground="#00796B"
                        Click="setsure_click"/>
                <Button Content="取消" Grid.Row="4" Grid.Column="1"
                        Width="80" Height="38"
                        Background="#E0F2F1" Foreground="#00796B"
                        Click="setcancel_click"/>
            </Grid>
        </Grid>

        <Border Grid.Column="1" BorderBrush="#00796B" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#E0F2F1" Padding="6" BorderBrush="#00796B" BorderThickness="0 0 2 2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="序号" Width="48" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="名称" Width="90" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="数值" Width="70" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="指令" Width="55" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="写" Width="36" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="区块" Width="70" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="地址" Width="45" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="数量" Width="40" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="传输" Width="70" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="呈现" Width="65" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="系数" Width="40" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="偏移" Width="40" FontSize="11" FontWeight="Bold"/>

                        <StackPanel Orientation="Horizontal"
                                    IsVisible="{Binding Source={x:Static vm:AppViewModel.Instance},
                                              Path=ModbusSet.IsAdvancedColumnsVisible,
                                              Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="单位" Width="36" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="范围" Width="40" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="位偏" Width="40" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="位数" Width="40" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="小数" Width="40" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="字节" Width="40" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="字序" Width="40" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="曲线" Width="36" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="间隔ms" Width="50" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ListBox x:Name="dataGrodx"
                             ItemsSource="{Binding Path=ModbusDataList}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Path=ID}" Width="48" FontSize="11"/>
                                    <TextBlock Text="{Binding Path=Name}" Width="90" FontSize="11"/>
                                    <TextBlock Background="LightSkyBlue" Padding="2,1" Width="70" FontSize="11" Tapped="NumCell_Tapped">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ValueDisplayConverter}">
                                                <Binding Path="Value"/>
                                                <Binding Path="DisplayType"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBox Text="{Binding Path=Command}" Width="55" FontSize="11"/>
                                    <Button Content="写" Width="36" FontSize="10"
                                            Command="{Binding Source={x:Static vm:AppViewModel.Instance}, Path=ModbusSet.ButtonCommand}"
                                            CommandParameter="{Binding}"/>
                                    <ComboBox SelectedItem="{Binding Path=SelectedOption}"
                                              ItemsSource="{Binding Source={x:Static vm:AppViewModel.Instance}, Path=ModbusSet.ProtocolConfig.DataTypeOptions}"
                                              Width="70" FontSize="10"/>
                                    <TextBox Text="{Binding Path=Addr}" Width="45" FontSize="11"/>
                                    <TextBox Text="{Binding Path=Number}" Width="40" FontSize="11"/>
                                    <ComboBox SelectedItem="{Binding Path=TransferType}"
                                              ItemsSource="{Binding Source={x:Static vm:AppViewModel.Instance}, Path=ModbusSet.ProtocolConfig.TransferTypeOptions}"
                                              Width="70" FontSize="10"/>
                                    <ComboBox SelectedItem="{Binding Path=DisplayType}"
                                              ItemsSource="{Binding Source={x:Static vm:AppViewModel.Instance}, Path=ModbusSet.ProtocolConfig.DisplayTypeOptions}"
                                              Width="65" FontSize="10"/>
                                    <TextBox Text="{Binding Path=Coefficient}" Width="40" FontSize="11"/>
                                    <TextBox Text="{Binding Path=Offset}" Width="40" FontSize="11"/>

                                    <StackPanel Orientation="Horizontal"
                                                IsVisible="{Binding Source={x:Static vm:AppViewModel.Instance},
                                                          Path=ModbusSet.IsAdvancedColumnsVisible,
                                                          Converter={StaticResource BoolToVisConverter}}">
                                        <TextBox Text="{Binding Path=Unit}" Width="36" FontSize="11"/>
                                        <TextBox Text="{Binding Path=Rangle}" Width="40" FontSize="11"/>
                                        <TextBox Text="{Binding Path=NOffSet}" Width="40" FontSize="11"/>
                                        <TextBox Text="{Binding Path=NBit}" Width="40" FontSize="11"/>
                                        <TextBox Text="{Binding Path=DecimalPlaces}" Width="40" FontSize="11"/>
                                        <TextBox Text="{Binding Path=ByteOrder}" Width="40" FontSize="11"/>
                                        <TextBox Text="{Binding Path=WordOrder}" Width="40" FontSize="11"/>
                                        <CheckBox IsChecked="{Binding Path=IsDrawCurve}" Width="36"/>
                                        <TextBox Text="{Binding Path=IntervalTime}" Width="50" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <TextBox Grid.Row="2"
                         TextWrapping="Wrap" Name="show_text"
                         Margin="3,0,0,0" AcceptsReturn="True"
                         Text="{Binding Path=BoxStr, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         TextChanged="ShowText_TextChanged"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
