<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:cross.ViewModels"
             xmlns:converters="using:cross.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="cross.GeneralDebugPage">

    <Grid>
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <converters:BoolToButtonTextConverter x:Key="BoolToButtonTextConverter"/>
            <converters:ValueDisplayConverter x:Key="ValueDisplayConverter"/>
            <converters:TransferTypeEnableConverter x:Key="TransferTypeEnableConverter"/>
            <vm:BindingProxy x:Key="ModbusSetProxy"
                             Data="{Binding Source={x:Static vm:AppViewModel.Instance}, Path=ModbusSet}"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26*"/>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26*"/>
                <ColumnDefinition Width="40*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>

            <TextBox HorizontalAlignment="Left" Grid.Row="0"
                     Text="协议类型" FontSize="10" Grid.ColumnSpan="2"
                     TextAlignment="Center" VerticalAlignment="Center"/>

            <ComboBox Name="cPro" FontSize="10" Grid.Row="0"
                      Margin="60,1,0,1" Grid.ColumnSpan="2"
                      ItemsSource="{Binding Path=Data.ProtocolConfig.ProtocolTypeOptions, Source={StaticResource ModbusSetProxy}}"
                      SelectedItem="{Binding Path=Data.ProtocolConfig.SelectedProtocolType, Mode=TwoWay, Source={StaticResource ModbusSetProxy}}"
                      SelectionChanged="cPro_SelectionChanged"/>

            <Button x:Name="ButtonAdd" Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Grid.Row="1" Grid.ColumnSpan="2" Click="ButtonAdd_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Fill="#00796B" Data="{StaticResource AddGeometry}" Margin="0,0,5,0"/>
                    <TextBlock Text="添加条目"/>
                </StackPanel>
            </Button>

            <Button x:Name="ButtonDelete" Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Grid.Row="2" Grid.ColumnSpan="2" Click="ButtonDelete_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Fill="#00796B" Data="{StaticResource DeleteGeometry}" Margin="0,0,5,0"/>
                    <TextBlock Text="删除条目"/>
                </StackPanel>
            </Button>

            <Button x:Name="ExportConfigBtn" Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Grid.Row="3" Grid.ColumnSpan="2" Click="ExportConfig_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Fill="#00796B" Data="{StaticResource ExportGeometry}" Margin="0,0,5,0"/>
                    <TextBlock Text="导出配置"/>
                </StackPanel>
            </Button>

            <Button x:Name="ImportConfigBtn" Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Grid.Row="4" Grid.ColumnSpan="2" Click="ImportConfig_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Fill="#00796B" Data="{StaticResource ImportGeometry}" Margin="0,0,5,0"/>
                    <TextBlock Text="导入配置"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="5" Grid.ColumnSpan="2"
                    Width="100" Height="38" Margin="0,0,10,0"
                    Background="#E0F2F1" Foreground="#00796B"
                    Command="{Binding Path=Data.ToggleAdvancedColumnsCommand, Source={StaticResource ModbusSetProxy}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Fill="#00796B" Data="{StaticResource ToggleGeometry}" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                              Converter={StaticResource BoolToButtonTextConverter}}"/>
                </StackPanel>
            </Button>

            <Grid Name="Setadd" Grid.Row="6" Grid.ColumnSpan="2" IsVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="40*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>

                <TextBox Text="参数名" Grid.Row="0" IsReadOnly="True"/>
                <TextBox Grid.Row="0" Grid.Column="1" />

                <TextBox Text="数值" Grid.Row="1" IsReadOnly="True"/>
                <TextBox Text="{Binding Path=Data.Snum, Source={StaticResource ModbusSetProxy}, Mode=TwoWay}"
                         Grid.Row="1" Grid.Column="1"/>

                <TextBox Text="类型" Grid.Row="2" IsReadOnly="True"/>
                <Border Grid.Row="2" Grid.Column="1"
                        CornerRadius="6" Background="#E0F2F1"
                        Margin="8" ClipToBounds="True">
                    <ComboBox Name="cbProcho" FontSize="10"
                              ItemsSource="{Binding Path=Data.ProtocolConfig.DataTypeOptions, Source={StaticResource ModbusSetProxy}}"
                              SelectedItem="{Binding Path=Data.ProtocolConfig.SelectedDataType, Source={StaticResource ModbusSetProxy}, Mode=TwoWay}"
                              Background="Transparent" BorderThickness="0"
                              VerticalContentAlignment="Center" Padding="6,0"/>
                </Border>

                <TextBox Text="起始地址" Grid.Row="3" IsReadOnly="True"/>
                <TextBox Text="{Binding Path=Data.Sadd, Source={StaticResource ModbusSetProxy}, Mode=TwoWay}"
                         Grid.Row="3" Grid.Column="1"/>

                <Button Content="确定" Grid.Row="5" Grid.Column="0"
                        Width="80" Height="38"
                        Background="#E0F2F1" Foreground="#00796B"
                        Click="setsure_click" />
                <Button Content="取消" Grid.Row="5" Grid.Column="1"
                        Width="80" Height="38"
                        Background="#E0F2F1" Foreground="#00796B"
                        Click="setcancel_click" />
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"/>
                <RowDefinition Height="20*"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dataGrodx" Grid.Row="0"
                      ItemsSource="{Binding Path=Data.ModbusDataList, Source={StaticResource ModbusSetProxy}, Mode=TwoWay}"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding Path=ID}"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Path=Name}"/>

                    <DataGridTemplateColumn Header="数值" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Background="LightSkyBlue">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ValueDisplayConverter}">
                                            <Binding Path="Value"/>
                                            <Binding Path="DisplayType"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="指令"
                                        Binding="{Binding Path=Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTemplateColumn Header="写" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="写"
                                        Command="{Binding Source={x:Static vm:AppViewModel.Instance}, Path=ModbusSet.ButtonCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="单位" Binding="{Binding Path=Unit}"/>
                    <DataGridTextColumn Header="范围" Binding="{Binding Path=Rangle}"/>

                    <DataGridTemplateColumn Header="区块" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox FontSize="10"
                                          SelectedItem="{Binding Path=SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding Path=DataContext.Data.ProtocolConfig.DataTypeOptions,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="地址"
                                        Binding="{Binding Path=Addr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="数量"
                                        Binding="{Binding Path=Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="位偏移"
                                        Binding="{Binding Path=NOffSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="位数"
                                        Binding="{Binding Path=NBit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTextColumn Header="系数" Binding="{Binding Path=Coefficient}"
                                        IsVisible="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                                  Converter={StaticResource BoolToVisConverter}}"/>
                    <DataGridTextColumn Header="偏移" Binding="{Binding Path=Offset}"
                                        IsVisible="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                                  Converter={StaticResource BoolToVisConverter}}"/>
                    <DataGridTextColumn Header="小数位数" Binding="{Binding Path=DecimalPlaces}"
                                        IsVisible="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                                  Converter={StaticResource BoolToVisConverter}}"/>

                    <DataGridTemplateColumn Header="传输类型" Width="120"
                                            IsVisible="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                                      Converter={StaticResource BoolToVisConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox FontSize="10"
                                          SelectedItem="{Binding Path=TransferType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding Path=DataContext.Data.ProtocolConfig.TransferTypeOptions,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="呈现类型" Width="120"
                                            IsVisible="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                                      Converter={StaticResource BoolToVisConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox FontSize="10"
                                          SelectedItem="{Binding Path=DisplayType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding Path=DataContext.Data.ProtocolConfig.DisplayTypeOptions,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="字节序"
                                        Binding="{Binding Path=ByteOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsVisible="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                                  Converter={StaticResource BoolToVisConverter}}"/>
                    <DataGridTextColumn Header="字序"
                                        Binding="{Binding Path=WordOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsVisible="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                                  Converter={StaticResource BoolToVisConverter}}"/>
                    <DataGridCheckBoxColumn Header="是否绘制曲线" Binding="{Binding Path=IsDrawCurve}"
                                            IsVisible="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                                      Converter={StaticResource BoolToVisConverter}}"/>
                    <DataGridTextColumn Header="间隔时间（ms）" Binding="{Binding Path=IntervalTime}"
                                        IsVisible="{Binding Path=Data.IsAdvancedColumnsVisible, Source={StaticResource ModbusSetProxy},
                                                  Converter={StaticResource BoolToVisConverter}}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBox Grid.Row="1"
                     TextWrapping="Wrap" Name="show_text"
                     Margin="3,0,0,0" AcceptsReturn="True"
                     Text="{Binding Path=Data.BoxStr, Source={StaticResource ModbusSetProxy}, Mode=TwoWay}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextChanged="ShowText_TextChanged"/>
        </Grid>
    </Grid>
</UserControl>
